# Configuração do Banco de Dados PostgreSQL (via Docker Compose na porta 5433 para evitar conflitos locais)
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?schema=public
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/meufinanceiro?schema=public"

# Porta do Servidor Backend
PORT=3000
